*.gcda
*.gcno
*.gcov
coverage/
tags
TAGS
cscope.*
.ctags

# Локальные секреты / окружение
.env
.env.*
!.env.example
*.local

# Артефакты упаковки
*.tar
*.tar.gz
*.tar.bz2
*.tar.xz
*.zip
*.7z
*.rar
*.deb
*.rpm
*.dmg
